# Gemini
Gemini_API_KEY=your-gemini-api-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Tariff retrieval: summaries or rag
TARIFF_RETRIEVAL_MODE=summaries
TARIFF_RAG_TOP_K=5
TARIFF_RAG_DENSE_WEIGHT=0.65

# Voyage AI embeddings, required when TARIFF_RETRIEVAL_MODE=rag
VOYAGE_EMBEDDING_MODEL=voyage-3.5-lite
VOYAGE_EMBED_BATCH_SIZE=4
VOYAGE_API_KEY=your-voyage-api-key
